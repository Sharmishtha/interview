{
  "name": "interview",
  "version": "0.2.0",
  "description": "Voice-based executive interview practice for VP of Engineering candidates, with a behaviourally-anchored scoring rubric",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/node.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/server/node.js",
    "demo": "tsx src/index.ts",
    "eval": "tsx src/eval/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src server worker tests web/src",
    "format": "prettier --write .",
    "cf:dev": "npm run build && wrangler dev",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:prod": "npm run build && wrangler deploy --env production",
    "tail:staging": "wrangler tail --env staging",
    "tail:prod": "wrangler tail --env production",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@elevenlabs/elevenlabs-js": "^2.65.0",
    "@hono/node-server": "^2.1.1",
    "dotenv": "^16.4.7",
    "hono": "^4.13.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
